# tools/ is local scaffolding — the go-live wizard and the integration checker.
# It gets uploaded with the rest of the folder, so serve a 404 instead of the
# source. Nothing secret lives there; it simply is not part of the site.
/tools/*  /404.html  404

# The mock checkout is for local testing only (MOCK in assets/js/config.js).
# The JS already refuses to run off localhost; this keeps the files off the
# live site as well.
/mock-checkout.html  /404.html  404
/assets/mock/*       /404.html  404
